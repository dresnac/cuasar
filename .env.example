# --- Base de datos (Neon) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Storage / cache ---
BLOB_READ_WRITE_TOKEN=
EDGE_CONFIG=
REDIS_URL=

# --- Cobro ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Dominios ---
NEXT_PUBLIC_ROOT_DOMAIN=cuasar.app
