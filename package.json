{
  "name": "cuasar",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cuasar/db generate",
    "db:migrate": "pnpm --filter @cuasar/db migrate",
    "db:seed": "pnpm --filter @cuasar/db seed",
    "db:studio": "pnpm --filter @cuasar/db studio",
    "db:make-admin": "pnpm --filter @cuasar/db make-admin",
    "db:perf": "pnpm --filter @cuasar/db perf"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.0",
    "@types/node": "^22.15.0",
    "prettier": "^3.4.2"
  }
}
