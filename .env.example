# --- Notificaciones ---
# Sin estas dos, los mails quedan en el log y no se envían.
RESEND_API_KEY=
EMAIL_FROM="Cuasar <avisos@cuasar.app>"
# Protege /api/cron/outbox-drain. Vercel lo manda como Bearer.
CRON_SECRET=

# --- Sitio público ---
# El backoffice avisa acá cuando una agencia publica o cambia un precio.
PUBLIC_SITE_URL=http://localhost:3001
REVALIDATE_SECRET=
# Solo en desarrollo: qué agencia servir cuando el host es localhost.
DEV_AGENCY_SLUG=del-sur
